
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tmc",
  "main": "./public/functions/gui-mail.js",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./public/"
  },
  "routes": [
    {
      "pattern": "taxirachgia.tmc.io.vn",
      "custom_domain": true
    },
	{
      "pattern": "www.taxirachgia.tmc.io.vn",
      "custom_domain": true
    },
	{
      "pattern": "taxirachgialuxury.com",
      "custom_domain": true
    },
    {
      "pattern": "www.taxirachgialuxury.com",
      "custom_domain": true
    }
  ]
}
